{
	"nodes":[
		{"id":"6621e1b99060ee16","type":"group","x":840,"y":-180,"width":860,"height":260,"color":"2","label":"Более того"},
		{"id":"5635fd440a99f29c","type":"group","x":-2220,"y":720,"width":940,"height":220,"color":"2","label":"Но!"},
		{"id":"8322a1f6bc3c7e5b","type":"text","text":"Числительные","x":-860,"y":-340,"width":380,"height":60},
		{"id":"464c3ada448e4aab","type":"text","text":"Существительные в И. П.","x":-480,"y":-560,"width":380,"height":60},
		{"id":"6f6a3f1f045fa040","type":"text","text":"Инфинитивы","x":-100,"y":-340,"width":380,"height":60},
		{"id":"c5256f889af51935","type":"text","text":"Познание — главная цель жизни","x":-450,"y":-760,"width":320,"height":60,"color":"5"},
		{"id":"a5ed38ce39a659aa","type":"text","text":"Масса такого дальномера — 23 кг","x":-1180,"y":-560,"width":320,"height":60,"color":"5"},
		{"id":"e2bc04e492e7bc66","type":"text","text":"Долг — защищать Родину","x":280,"y":-560,"width":320,"height":60,"color":"5"},
		{"id":"9214ab67948138c8","type":"text","text":"Жить — Родине служить","x":460,"y":-340,"width":320,"height":60,"color":"5"},
		{"id":"9a1352f66ff73ec4","type":"text","text":"Дважды два — четыре","x":-1360,"y":-340,"width":320,"height":60,"color":"5"},
		{"id":"2f629aa92b1a5287","type":"text","text":"Подлежащее всегда стоит в И. П.","x":2640,"y":-560,"width":380,"height":60,"color":"4"},
		{"id":"6095e98fc14cf1ba","type":"text","text":"Тире между подлежащим и сказуемым","x":-480,"y":140,"width":380,"height":60,"color":"4"},
		{"id":"051ad079af1fdf23","type":"text","text":"Ставится","x":-367,"y":-80,"width":155,"height":60,"color":"6"},
		{"id":"49233e7d680cec91","type":"text","text":"Подлежащее — **личное местоимение**\n","x":-860,"y":580,"width":380,"height":60},
		{"id":"920bfb1bf9d7ccae","type":"text","text":"Они покорители космоса","x":-1360,"y":580,"width":320,"height":60,"color":"5"},
		{"id":"2b754890a79de25a","type":"text","text":"На практике в предложении вместо тире стоит попробовать использовать слово «есть»","x":-1120,"y":120,"width":320,"height":100,"color":"2"},
		{"id":"089afad1642fb537","type":"text","text":"Бедность не порок","x":-861,"y":980,"width":380,"height":60,"color":"5"},
		{"id":"c5fd8b6fcdcb3e0a","type":"text","text":"**Не** относится к инфинитиву — ставим","x":-1680,"y":740,"width":380,"height":60},
		{"id":"bb2e02e700f76731","type":"text","text":"Списывать из интернета — не самому думать","x":-2200,"y":740,"width":420,"height":60,"color":"5"},
		{"id":"ce482d7e1cd60d46","type":"text","text":"**Это**, **вот**, **значит** — ставим","x":-1680,"y":840,"width":380,"height":60},
		{"id":"f74fc5c365fdf533","type":"text","text":"Списывание — это не хитрость, а…","x":-2200,"y":840,"width":420,"height":60,"color":"5"},
		{"id":"9a0deb5d9cec76c5","type":"text","text":"Не ставится ","x":-367,"y":380,"width":155,"height":60,"color":"1"},
		{"id":"1f312a01e4c76371","type":"text","text":"Между подлежащим и сказуемым есть **сравнительный союз**\n\n","x":-100,"y":580,"width":380,"height":60},
		{"id":"4306b54e4177f9b5","type":"text","text":"Озеро словно зеркало","x":460,"y":580,"width":320,"height":60,"color":"5"},
		{"id":"16b4188487661ba2","type":"text","text":"Сказуемое — фразеологизм","x":860,"y":-160,"width":380,"height":60},
		{"id":"f9a634654e2a6949","type":"text","text":"Указательные слова **это**, **вот** или **значит**","x":860,"y":0,"width":380,"height":60},
		{"id":"cc232024ab220ff5","type":"text","text":"Грач, конечно, птица умная и самостоятельная","x":-101,"y":980,"width":380,"height":60,"color":"5"},
		{"id":"890dbc925f579dce","type":"text","text":"В камень стрелять только стрелы терять","x":-480,"y":1160,"width":380,"height":60,"color":"5"},
		{"id":"a666255d13ff6410","type":"text","text":"Между подлежащим и сказуемым есть \n**не**, **частица** или **вводное слово**\n","x":-481,"y":800,"width":380,"height":60},
		{"id":"234df4e3d4b859e1","type":"text","text":"Тире может ставится или не ставится, вопреки правилам, если это обусловлено интонацией, стилистикой, средствами выразительности","x":219,"y":120,"width":421,"height":100,"color":"2"},
		{"id":"1c5b8896be5fa0e1","type":"text","text":"Пицца — пальчики оближешь","x":1360,"y":-160,"width":320,"height":60,"color":"5"},
		{"id":"8c7344db4f96e98d","type":"text","text":"Каникулы — вот настоящая свобода!","x":1360,"y":0,"width":320,"height":60,"color":"5"},
		{"id":"fb6328dd0450299b","type":"text","text":"Тире ставится в неполных предложениях","x":2120,"y":140,"width":380,"height":60,"color":"4"}
	],
